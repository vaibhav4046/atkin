{
  "name": "atkin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Atkin reads the pile so you can decide.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
